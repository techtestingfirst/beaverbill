{
    "actions": [],
    "allow_rename": 1,
    "doctype": "DocType",
    "editable_grid": 1,
    "engine": "InnoDB",
    "field_order": [
        "section_break_rule",
        "tax_name",
        "country",
        "column_break_2",
        "state_code",
        "gst_mode",
        "section_break_applies",
        "product_group",
        "column_break_4",
        "rate",
        "section_break_validity",
        "effective_from",
        "effective_to",
        "column_break_6",
        "is_active",
        "tax_level",
        "tax_type"
    ],
    "fields": [
        {
            "fieldname": "tax_name",
            "fieldtype": "Data",
            "in_list_view": 1,
            "label": "Tax Name",
            "reqd": 1,
            "unique": 1
        },
        {
            "fieldname": "country",
            "fieldtype": "Data",
            "in_list_view": 1,
            "label": "Country (blank = all)"
        },
        {
            "fieldname": "state_code",
            "fieldtype": "Data",
            "label": "State Code (for India GST origin)"
        },
        {
            "fieldname": "gst_mode",
            "fieldtype": "Select",
            "label": "India GST Mode",
            "options": "None\nCGST + SGST\nIGST",
            "default": "None"
        },
        {
            "fieldname": "product_group",
            "fieldtype": "Link",
            "label": "Product Group (blank = all)",
            "options": "Hosting Product Group"
        },
        {
            "fieldname": "rate",
            "fieldtype": "Percent",
            "in_list_view": 1,
            "label": "Rate %",
            "reqd": 1
        },
        {
            "fieldname": "effective_from",
            "fieldtype": "Date",
            "label": "Effective From"
        },
        {
            "fieldname": "effective_to",
            "fieldtype": "Date",
            "label": "Effective To"
        },
        {
            "fieldname": "is_active",
            "fieldtype": "Check",
            "label": "Is Active",
            "default": 1
        },
        {
            "fieldname": "section_break_rule",
            "fieldtype": "Section Break",
            "label": "Rule"
        },
        {
            "fieldname": "column_break_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "section_break_applies",
            "fieldtype": "Section Break",
            "label": "Applies"
        },
        {
            "fieldname": "column_break_4",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "section_break_validity",
            "fieldtype": "Section Break",
            "label": "Validity"
        },
        {
            "fieldname": "column_break_6",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "tax_level",
            "fieldtype": "Select",
            "label": "Level",
            "options": "1\n2",
            "default": "1"
        },
        {
            "fieldname": "tax_type",
            "fieldtype": "Select",
            "label": "Tax Type",
            "options": "Exclusive\nInclusive\nAdditive",
            "default": "Exclusive"
        }
    ],
    "index_web_pages_for_search": 1,
    "links": [],
    "module": "BeaverBill",
    "name": "Hosting Tax Rule",
    "permissions": [
        {
            "create": 1,
            "delete": 1,
            "email": 1,
            "export": 1,
            "print": 1,
            "read": 1,
            "report": 1,
            "role": "System Manager",
            "share": 1,
            "write": 1
        }
    ],
    "sort_field": "modified",
    "sort_order": "DESC",
    "states": []
}
