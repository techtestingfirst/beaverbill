    "fields": [
        {
            "fieldname": "customer",
            "fieldtype": "Link",
            "in_list_view": 1,
            "label": "Customer",
            "options": "User",
            "reqd": 1
        },
        {
            "fieldname": "payment_date",
            "fieldtype": "Date",
            "in_list_view": 1,
            "label": "Payment Date",
            "reqd": 1
        },
        {
            "fieldname": "amount",
            "fieldtype": "Currency",
            "in_list_view": 1,
            "label": "Amount",
            "reqd": 1
        },
        {
            "fieldname": "currency",
            "fieldtype": "Link",
            "label": "Currency",
            "options": "Currency",
            "default": "USD"
        },
        {
            "default": "Created",
            "fieldname": "status",
            "fieldtype": "Select",
            "in_list_view": 1,
            "label": "Status",
            "options": "Created\nAuthorized\nCaptured\nFailed\nRefunded\nPartially Refunded\nChargeback",
            "reqd": 1
        },
        {
            "fieldname": "gateway",
            "fieldtype": "Data",
            "label": "Gateway"
        },
        {
            "fieldname": "gateway_reference",
            "fieldtype": "Data",
            "label": "Gateway Reference",
            "unique": 1
        },
        {
            "fieldname": "gateway_event_id",
            "fieldtype": "Data",
            "label": "Last Gateway Event ID"
        },
        {
            "fieldname": "payment_token_ref",
            "fieldtype": "Data",
            "label": "Payment Token Reference (never store card numbers)"
        },
        {
            "default": "0",
            "fieldname": "retry_count",
            "fieldtype": "Int",
            "label": "Retry Count"
        },
        {
            "fieldname": "next_retry_at",
            "fieldtype": "Datetime",
            "label": "Next Retry At"
        },
        {
            "fieldname": "last_error",
            "fieldtype": "Small Text",
            "label": "Last Error"
        },
        {
            "fieldname": "idempotency_key",
            "fieldtype": "Data",
            "label": "Idempotency Key",
            "unique": 1
        },
        {
            "fieldname": "source_invoice",
            "fieldtype": "Link",
            "label": "Source Invoice",
            "options": "Hosting Invoice"
        },
        {
            "fieldname": "remarks",
            "fieldtype": "Small Text",
            "label": "Remarks"
        },
        {
            "fieldname": "section_break_payment",
            "fieldtype": "Section Break",
            "label": "Payment"
        },
        {
            "fieldname": "column_break_2",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "section_break_gateway",
            "fieldtype": "Section Break",
            "label": "Gateway"
        },
        {
            "fieldname": "column_break_4",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "section_break_retry",
            "fieldtype": "Section Break",
            "label": "Retry"
        },
        {
            "fieldname": "column_break_6",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "section_break_references",
            "fieldtype": "Section Break",
            "label": "References"
        },
        {
            "fieldname": "column_break_8",
            "fieldtype": "Column Break"
        }
    ],
    "index_web_pages_for_search": 1,
    "indexes": [
        {
            "fields": [
                "customer",
                "status"
            ]
        },
        {
            "fields": [
                "idempotency_key"
            ]
        }
    ],
    "links": [],
