{
    "actions": [],
    "allow_rename": 1,
    "autoname": "format:PAY-{####}",
    "doctype": "DocType",
    "editable_grid": 1,
    "engine": "InnoDB",
    "field_order": [
        "section_break_payment",
        "customer",
        "payment_date",
        "column_break_2",
        "amount",
        "currency",
        "status",
        "section_break_gateway",
        "gateway",
        "gateway_reference",
        "column_break_4",
        "gateway_event_id",
        "payment_token_ref",
        "section_break_retry",
        "retry_count",
        "next_retry_at",
        "column_break_6",
        "last_error",
        "section_break_references",
        "idempotency_key",
